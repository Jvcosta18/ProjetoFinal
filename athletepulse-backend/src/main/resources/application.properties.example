spring.application.name=athletepulse-backend

# ===== BANCO DE DADOS =====
# Ajuste usuario/senha/host conforme seu ambiente.
# O banco "athletepulse" precisa existir (CREATE DATABASE athletepulse;) antes de subir a aplicacao.
spring.datasource.url=jdbc:mysql://localhost:3306/athletepulse?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=SEU_USUARIO_AQUI
spring.datasource.password=SUA_SENHA_AQUI

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ===== JWT =====
# IMPORTANTE: gere um segredo proprio (>= 32 caracteres aleatorios) antes de ir pra producao.
# Nunca versione o segredo real no git - use variavel de ambiente (JWT_SECRET).
app.jwt.secret=${JWT_SECRET:troque-este-segredo-em-producao-0123456789abcdef}
app.jwt.expiracao-ms=86400000

# ===== CORS =====
# Origem do front-end (ajuste se usar Live Server, outra porta, etc.)
app.cors.origens-permitidas=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

server.port=8080
